<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox выключен: Accessibility API и запуск/закрытие чужих приложений в песочнице не работают.
	     Распространение — Developer ID + нотаризация, не Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Hardened Runtime: доступ к микрофону требует явного entitlement. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Hardened Runtime: AppleScript (громкость). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
